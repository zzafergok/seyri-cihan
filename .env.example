# Tulpar Environment Variables Example

# Application URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000

# Backend API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Authentication & Security
# WARNING: Generate a secure random string for production (e.g. openssl rand -base64 32)
JWT_SECRET=tulpar-secret-key-change-in-production

# Node Environment
NODE_ENV=development
