{
  "name": "tulpar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tulpar is a premium, domain-neutral Next.js 16 enterprise application foundation featuring React 19, Zustand, TanStack React Query, API Interceptors, HTTP Security Headers, and Radix UI Brutalist design system inspired by ancient Turkic mythology and cosmic symbolism.",
  "author": "Tulpar Team",
  "license": "MIT",
  "keywords": [
    "tulpar",
    "nextjs",
    "react19",
    "typescript",
    "tailwind",
    "zustand",
    "tanstack-react-query",
    "radix-ui",
    "brutalist-design",
    "turkish-culture",
    "enterprise-template"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "metadata:check": "node scripts/check-route-metadata.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
